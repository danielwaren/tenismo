---
import '../styles/global.css';
import Logo from '../components/Logo.astro';

interface Props {
  title?: string;
  subtitle?: string;
  active?: string;
}
const { title = 'Tennis Trader Intelligence', subtitle, active } = Astro.props;

const nav = [
  { href: '/', label: 'Inicio', key: 'home', icon: '⌂' },
  { href: '/ranking', label: 'Rankings', key: 'ranking', icon: '↗' },
  { href: '/trading', label: 'Seguimiento', key: 'trading', icon: '◎' },
  { href: '/paper-trading', label: 'Simulador', key: 'paper', icon: '◇' },
  { href: '/calibracion', label: 'Modelo', key: 'calibracion', icon: '⌁' },
  { href: '/guia', label: 'Guía', key: 'guia', icon: '?' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="Análisis y pronóstico de tenis ATP y WTA contrastado con el mercado." />
  </head>
  <body class="min-h-dvh pb-20 lg:pb-0">
    <div class="mx-auto min-h-dvh max-w-[1500px] lg:grid lg:grid-cols-[15.5rem_minmax(0,1fr)]">
      <aside class="sticky top-0 hidden h-dvh border-r border-line/70 bg-bg/80 p-5 backdrop-blur-xl lg:flex lg:flex-col">
        <a href="/" class="block no-underline">
          <Logo class="w-full max-w-[12.5rem]" />
        </a>
        <p class="mt-1.5 text-2xs uppercase tracking-[0.16em] text-ink-faint">Tennis intelligence</p>
        <nav class="mt-10 space-y-1.5" aria-label="Principal">
          {nav.map((n) => (
            <a href={n.href} aria-current={active === n.key ? 'page' : undefined} class:list={[
              'group flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium no-underline',
              active === n.key ? 'bg-court text-bg shadow-[0_0_30px_hsl(var(--court)/.16)]' : 'text-ink-muted hover:bg-surface-2 hover:text-ink',
            ]}>
              <span class:list={['grid h-7 w-7 place-items-center rounded-lg text-base', active === n.key ? 'bg-bg/10' : 'bg-surface-2 text-ink-faint group-hover:text-court']}>{n.icon}</span>
              {n.label}
            </a>
          ))}
        </nav>
        <div class="mt-auto rounded-2xl border border-court/20 bg-gradient-to-br from-court/10 to-transparent p-4">
          <p class="eyebrow">Cobertura</p>
          <p class="mt-2 text-sm font-medium text-ink">ATP · WTA · Challenger</p>
          <p class="mt-1 text-xs leading-relaxed text-ink-faint">Datos observados, modelo auditable y fuentes identificadas.</p>
        </div>
      </aside>

      <div class="min-w-0">
        <header class="sticky top-0 z-40 border-b border-line/70 bg-bg/80 backdrop-blur-xl lg:hidden">
          <div class="flex h-16 items-center justify-between px-4">
            <a href="/" class="no-underline"><Logo class="h-8 w-auto" /></a>
            <a href="#buscar" class="rounded-full border border-line bg-surface px-3 py-1.5 text-xs font-medium text-ink-muted no-underline">Buscar</a>
          </div>
        </header>

        <main class="mx-auto max-w-[1240px] px-4 py-6 sm:px-7 sm:py-8 xl:px-10">
          {subtitle && <p class="mb-6 max-w-2xl text-sm leading-relaxed text-ink-muted">{subtitle}</p>}
          <slot />
        </main>

        <footer class="mx-auto max-w-[1240px] border-t border-line/70 px-4 py-8 text-xs leading-relaxed text-ink-faint sm:px-7 xl:px-10">
          <p>TENISMO es una herramienta informativa y de análisis. No ejecuta apuestas ni gestiona dinero real.</p>
          <p class="mt-2">
            Fotos de jugadores vía <a href="https://www.tennisabstract.com" target="_blank" rel="noopener noreferrer"
              class="text-ink-faint underline decoration-dotted underline-offset-2 hover:text-court">Tennis Abstract</a>,
            cada una acreditada a su autor en la ficha del jugador.
          </p>
        </footer>
      </div>
    </div>

    <nav class="fixed inset-x-3 bottom-3 z-50 grid grid-cols-5 rounded-2xl border border-white/10 bg-surface/95 p-1.5 shadow-2xl backdrop-blur-xl lg:hidden" aria-label="Principal móvil">
      {nav.slice(0, 5).map((n) => (
        <a href={n.href} aria-current={active === n.key ? 'page' : undefined} class:list={[
          'flex min-w-0 flex-col items-center gap-0.5 rounded-xl px-1 py-1.5 text-[10px] font-medium no-underline',
          active === n.key ? 'bg-court text-bg' : 'text-ink-faint',
        ]}><span class="text-base leading-none">{n.icon}</span><span class="truncate">{n.label}</span></a>
      ))}
    </nav>
  </body>
</html>
