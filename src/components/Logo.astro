---
/**
 * Marca de TENISMO: el lockup completo (pelota + gráfico de barras + palabra).
 *
 * El PNG viene con FONDO NEGRO horneado, no transparente, así que se compone
 * con `mix-blend-mode: screen`: sobre negro puro el blend "screen" devuelve el
 * fondo tal cual, de modo que el rectángulo desaparece y el resplandor del
 * logo se funde con el degradado del `body`. Recortar un alpha a mano habría
 * mordido ese resplandor. La app es dark-only (`color-scheme: dark` fijo en
 * global.css), así que no hay caso claro donde el blend falle.
 *
 * `width`/`height` van puestos para reservar el hueco y no provocar salto de
 * layout mientras carga.
 */
interface Props { class?: string }
const { class: cls = 'h-8 w-auto' } = Astro.props;
---
<img
  src="/tenismo-logo.png"
  alt="TENISMO"
  width="720"
  height="165"
  decoding="async"
  class:list={['mix-blend-screen', cls]}
/>
