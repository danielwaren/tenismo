---
import type { LiveTournamentDisplay, LiveProviderStatus } from '../lib/live';
const { tournaments, status } = Astro.props as { tournaments: LiveTournamentDisplay[]; status: LiveProviderStatus };
---

<section class="mb-8">
  <div class="mb-3 flex items-baseline justify-between gap-3">
    <h2 class="font-display text-lg font-semibold">Torneos en vivo</h2>
    {status === 'partial' && <span class="text-2xs text-amber-300">cobertura parcial</span>}
  </div>
  {tournaments.length ? (
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {tournaments.map((tournament) => {
        const content = <>
          <div class="flex items-center justify-between gap-2 text-2xs text-ink-muted">
            <span class={`chip ${tournament.tour === 'ATP' ? 'chip-atp' : 'chip-wta'}`}>{tournament.tour}</span>
            <span class="flex items-center gap-1.5 text-live"><span class="h-2 w-2 animate-pulse rounded-full bg-live"></span> EN VIVO</span>
          </div>
          <div class="mt-2 font-display font-semibold text-ink">{tournament.name}</div>
          <div class="mt-3 flex flex-wrap gap-1.5 text-2xs">
            <span class="chip bg-live/15 text-live">{tournament.liveMatches} {tournament.liveMatches === 1 ? 'partido' : 'partidos'}</span>
            {tournament.unresolvedMatches > 0 && <span class="chip bg-amber-500/10 text-amber-300">{tournament.unresolvedMatches} sin vincular</span>}
          </div>
          {tournament.internalId === null && <p class="mt-2 text-2xs text-ink-faint">Ficha del torneo pendiente de vinculación.</p>}
        </>;
        const classes = 'card-hover block p-4 no-underline';
        return tournament.internalId === null
          ? <article class={classes}>{content}</article>
          : <a href={`/tournament/${tournament.internalId}`} class={classes}>{content}</a>;
      })}
    </div>
  ) : (
    <div class="card p-4 text-sm text-ink-muted">
      {status === 'unavailable' ? 'No fue posible comprobar los torneos en vivo.' : 'No hay torneos con partidos en vivo ahora mismo.'}
    </div>
  )}
</section>
