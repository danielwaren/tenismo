---
import type { ChallengerCalendarSnapshot } from '../lib/challenger';
import { challengerPath } from '../lib/urls';

const { snapshot } = Astro.props as { snapshot: ChallengerCalendarSnapshot };

const explorer = snapshot.source === 'tennis-explorer';

/**
 * En el panel solo van las TARJETAS de torneo, cada una enlazando a su cuadro.
 * Antes debajo se listaban los partidos sueltos del día: con cinco torneos eran
 * veinte filas de partidos casi todos terminados, que ocupaban media pantalla y
 * no llevaban a ninguna parte. El detalle vive en la ficha del torneo.
 */
const porTorneo = new Map<string, { jugando: number; jugados: number; porJugar: number }>();
for (const m of snapshot.matches) {
  const acc = porTorneo.get(m.tournamentId) ?? { jugando: 0, jugados: 0, porJugar: 0 };
  if (m.status === 'live') acc.jugando++;
  else if (m.status === 'completed') acc.jugados++;
  else acc.porJugar++;
  porTorneo.set(m.tournamentId, acc);
}
---
<section class="mb-8">
  <div class="mb-4 flex flex-wrap items-baseline justify-between gap-3">
    <div>
      <p class="eyebrow">Circuito secundario</p>
      <h2 class="section-title mt-1">ATP Challenger</h2>
    </div>
    <span class="text-2xs text-ink-faint">{explorer ? 'torneos de hoy' : `próximos ${snapshot.horizonDays} días`}</span>
  </div>

  {snapshot.status === 'unconfigured' ? (
    <div class="card p-4 text-sm text-ink-muted">El proveedor Challenger no está conectado.</div>
  ) : snapshot.status === 'unavailable' || !snapshot.tournaments.length ? (
    <div class="card p-4 text-sm text-ink-muted">Hoy no hay torneos Challenger con partidos publicados.</div>
  ) : (<>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {snapshot.tournaments.map((t) => {
        const c = porTorneo.get(t.id) ?? { jugando: 0, jugados: 0, porJugar: 0 };
        return (
          <a href={challengerPath(t.id)} class="card-hover block p-4 no-underline">
            <div class="flex items-center justify-between gap-2 text-2xs text-ink-muted">
              <span class="chip bg-surface-2 text-ink-muted">Challenger</span>
              {c.jugando > 0 && (
                <span class="chip border border-live/30 bg-live/10 text-live">
                  <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-live"></span> {c.jugando} en vivo
                </span>
              )}
            </div>
            <div class="mt-2 font-display font-semibold text-ink">{t.name}</div>
            <div class="mt-3 flex flex-wrap gap-1.5 text-2xs">
              {c.porJugar > 0 && <span class="chip bg-court/15 text-court-ink">{c.porJugar} por jugar</span>}
              {c.jugados > 0 && <span class="chip bg-surface-2 text-ink-muted">{c.jugados} jugados</span>}
            </div>
            <div class="mt-3 flex items-center justify-between text-2xs text-ink-faint">
              <span>{t.matchCount} partidos</span>
              <span aria-hidden="true">Ver cuadro →</span>
            </div>
          </a>
        );
      })}
    </div>

    {explorer && (
      <p class="mt-3 text-2xs leading-relaxed text-ink-faint">
        Datos de <a href="https://www.tennisexplorer.com" target="_blank" rel="noopener noreferrer"
          class="text-ink-faint underline decoration-dotted underline-offset-2 hover:text-court">tennisexplorer.com</a>.
        El marcador se refresca cada pocos minutos, no punto a punto.
      </p>
    )}
  </>)}
</section>
