---
import Base from '../../layouts/Base.astro';
import MatchList from '../../components/MatchList.tsx';
import PlayerAvatar from '../../components/PlayerAvatar.astro';
import { getPlayerProfile, getAceEstimates } from '../../lib/queries';
import { SURFACE_ES, SURFACE_DOT, fmtDate, tourChip } from '../../lib/format';
import { idFromReadablePath, playerPath } from '../../lib/urls';

export const prerender = false;

const id = idFromReadablePath(Astro.params.id);
const profile = id !== null ? await getPlayerProfile(id) : null;
if (!profile) return new Response(null, { status: 404, statusText: 'Jugador no encontrado' });
const canonicalPath = playerPath(profile.id, profile.slug);
if (Astro.url.pathname !== canonicalPath) return Astro.redirect(canonicalPath, 301);

const aces = Object.fromEntries(await getAceEstimates(profile.matches.map((match) => match.id)));
const pct = (value: number | null) => value === null ? '—' : `${Math.round(value * 100)}%`;
const decimal = (value: number | null) => value === null ? '—' : value.toFixed(1).replace('.', ',');
const elo = (value: number | null) => value === null ? '—' : Math.round(value).toLocaleString('es-CL');
// Solo los 3 últimos: la ficha ya cuenta el balance, el Elo y la evolución
// arriba, así que un muro de 20 tarjetas no añadía lectura y empujaba el resto
// de la página fuera de pantalla. Para el histórico completo está el cuadro
// de cada torneo.
const RECIENTES = 3;
const completedAll = profile.matches.filter((match) => match.status === 'completed');
const completed = completedAll.slice(0, RECIENTES);
const upcoming = profile.matches.filter((match) => match.status === 'scheduled');

const history = profile.eloHistory;
const chartWidth = 700, chartHeight = 150, pad = 12;
const minElo = history.length ? Math.min(...history.map((point) => point.elo)) : 0;
const maxElo = history.length ? Math.max(...history.map((point) => point.elo)) : 0;
const span = Math.max(1, maxElo - minElo);
const chartPoints = history.map((point, index) => {
  const x = pad + (history.length === 1 ? 0 : index * (chartWidth - pad * 2) / (history.length - 1));
  const y = chartHeight - pad - ((point.elo - minElo) / span) * (chartHeight - pad * 2);
  return `${x.toFixed(1)},${y.toFixed(1)}`;
}).join(' ');
---

<Base title={`${profile.name} · TENISMO`}>
  <a href="/" class="mb-4 inline-flex items-center gap-1 text-sm text-court-ink no-underline hover:text-court">← Volver</a>

  <header class="card mb-6 overflow-hidden p-5 sm:p-6">
    <div class="flex items-start gap-4 sm:gap-5">
      <div class="shrink-0">
        <PlayerAvatar name={profile.name} playerId={profile.id} hasPhoto={!!profile.photo} size="xl" />
        {/* La atribución va PEGADA a la foto, no escondida en el pie: son
            imágenes con licencia y el crédito es parte de poder usarlas. */}
        {profile.photo && (
          <p class="mt-1.5 max-w-24 text-center text-[10px] leading-tight text-ink-faint">
            Foto:{' '}
            <a href={profile.photo.creditUrl} target="_blank" rel="noopener noreferrer nofollow"
               class="text-ink-faint underline decoration-dotted underline-offset-2 hover:text-court">
              {profile.photo.credit}
            </a>
          </p>
        )}
      </div>
      <div class="min-w-0 flex-1">
        <div class="flex flex-wrap items-center gap-2 text-2xs text-ink-muted">
          <span class={`chip ${tourChip(profile.tour)}`}>{profile.tour}</span>
          {profile.country && <span class="chip bg-surface-2 text-ink-muted">{profile.country}</span>}
          {profile.firstSeason && profile.lastSeason && <span>{profile.firstSeason}–{profile.lastSeason}</span>}
        </div>
        <h1 class="mt-3 font-display text-3xl font-semibold tracking-tight text-ink">{profile.name}</h1>
      </div>
    </div>
    <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4">
      <div><p class="text-2xs uppercase tracking-wide text-ink-faint">Elo global</p><p class="mt-1 font-mono text-xl text-court">{elo(profile.stats.eloOverall)}</p></div>
      <div><p class="text-2xs uppercase tracking-wide text-ink-faint">Elo 2 años</p><p class="mt-1 font-mono text-xl text-ink">{elo(profile.stats.eloRecent)}</p></div>
      <div><p class="text-2xs uppercase tracking-wide text-ink-faint">Balance</p><p class="mt-1 font-mono text-xl text-ink">{Math.round((profile.stats.winRate ?? 0) * profile.stats.matches)}–{profile.stats.matches - Math.round((profile.stats.winRate ?? 0) * profile.stats.matches)}</p></div>
      <div><p class="text-2xs uppercase tracking-wide text-ink-faint">Último ranking</p><p class="mt-1 font-mono text-xl text-ink">{profile.lastRanking?.rank ? `#${profile.lastRanking.rank}` : '—'}</p>{profile.lastRanking && <p class="text-2xs text-ink-faint">al {fmtDate(profile.lastRanking.date)}</p>}</div>
    </div>
    {profile.stats.recentForm.length > 0 && <div class="mt-5 flex items-center gap-2"><span class="text-2xs uppercase tracking-wide text-ink-faint">Forma</span>{profile.stats.recentForm.map((result) => <span class={`flex h-7 w-7 items-center justify-center rounded-full text-xs font-semibold ${result === 'W' ? 'bg-court/15 text-court' : 'bg-live/10 text-live'}`}>{result === 'W' ? 'V' : 'D'}</span>)}</div>}
  </header>

  <section class="mb-8">
    <h2 class="mb-3 font-display text-lg font-semibold">Rendimiento por superficie</h2>
    <div class="card overflow-x-auto">
      <table class="w-full min-w-[540px] text-sm">
        <thead class="border-b border-line bg-surface-2/50 text-left text-2xs uppercase tracking-wide text-ink-faint"><tr><th class="px-4 py-3">Superficie</th><th class="px-4 py-3 text-right">Elo</th><th class="px-4 py-3 text-right">Partidos</th><th class="px-4 py-3 text-right">Victorias</th><th class="px-4 py-3 text-right">Rendimiento</th></tr></thead>
        <tbody class="divide-y divide-line/50">{profile.surfaces.map((surface) => <tr><td class="px-4 py-3"><span class="flex items-center gap-2"><span class={`h-2 w-2 rounded-full ${SURFACE_DOT[surface.surface] ?? 'bg-ink-faint'}`}></span>{SURFACE_ES[surface.surface] ?? surface.surface}</span></td><td class="px-4 py-3 text-right font-mono">{elo(surface.elo)}</td><td class="px-4 py-3 text-right font-mono text-ink-muted">{surface.matches}</td><td class="px-4 py-3 text-right font-mono text-ink-muted">{surface.wins}</td><td class="px-4 py-3 text-right font-mono">{pct(surface.winRate)}</td></tr>)}</tbody>
      </table>
    </div>
  </section>

  {history.length > 1 && <section class="mb-8">
    <div class="mb-3 flex items-baseline justify-between gap-3"><h2 class="font-display text-lg font-semibold">Evolución Elo</h2><span class="text-2xs text-ink-faint">últimos {history.length} registros</span></div>
    <div class="card p-4"><svg viewBox={`0 0 ${chartWidth} ${chartHeight}`} class="h-40 w-full" role="img" aria-label={`Evolución Elo de ${profile.name}, de ${Math.round(minElo)} a ${Math.round(maxElo)}`}><line x1={pad} y1={chartHeight - pad} x2={chartWidth - pad} y2={chartHeight - pad} class="stroke-line"></line><polyline points={chartPoints} fill="none" class="stroke-court" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></polyline></svg><div class="mt-1 flex justify-between text-2xs text-ink-faint"><span>{fmtDate(history[0].date)} · {elo(history[0].elo)}</span><span>{fmtDate(history.at(-1)!.date)} · {elo(history.at(-1)!.elo)}</span></div></div>
  </section>}

  <section class="mb-8">
    <div class="mb-3 flex items-baseline justify-between gap-3"><h2 class="font-display text-lg font-semibold">Saque y presión</h2><span class="text-2xs text-ink-faint">muestra: {profile.serve.matches} partidos con estadísticas</span></div>
    {profile.serve.matches > 0 ? <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">{[
      ['Aces/partido', decimal(profile.serve.acesPerMatch)], ['Dobles faltas', decimal(profile.serve.doubleFaultsPerMatch)],
      ['Primer saque', pct(profile.serve.firstServeIn)], ['1º saque ganado', pct(profile.serve.firstServeWon)],
      ['2º saque ganado', pct(profile.serve.secondServeWon)], ['BP salvados', pct(profile.serve.breakPointsSaved)],
    ].map(([label, value]) => <div class="card p-3"><p class="text-2xs text-ink-faint">{label}</p><p class="mt-1 font-mono text-lg text-ink">{value}</p></div>)}</div> : <div class="card p-4 text-sm text-ink-muted">No hay estadísticas punto a punto suficientes para este jugador.</div>}
  </section>

  {upcoming.length > 0 && <section class="mb-8"><h2 class="mb-3 font-display text-lg font-semibold">Próximos partidos</h2><MatchList client:visible matches={upcoming} aces={aces} /></section>}
  <section><div class="mb-3 flex items-baseline justify-between gap-3"><h2 class="font-display text-lg font-semibold">Partidos recientes</h2><span class="text-2xs text-ink-faint">últimos {completed.length} de {completedAll.length}</span></div><MatchList client:visible matches={completed} aces={aces} /></section>

  <p class="mt-6 text-2xs leading-relaxed text-ink-faint">Los ratings ATP y WTA pertenecen a escalas independientes. Los porcentajes y estadísticas se calculan solo con partidos disponibles en TENISMO; una muestra incompleta se identifica explícitamente.</p>
</Base>
