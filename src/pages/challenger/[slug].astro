---
import Base from '../../layouts/Base.astro';
import PlayerAvatar from '../../components/PlayerAvatar.astro';
import ChallengerDraw from '../../components/ChallengerDraw.tsx';
import { getChallengerCalendar, getChallengerDraw } from '../../lib/challenger';
import { getModelForecast } from '../../lib/model-forecast';
import { getAceEstimatesForPairs } from '../../lib/queries';
import { challengerSlug } from '../../lib/urls';

export const prerender = false;

// URL limpia ("hagen-challenger-2026"), no la ruta cruda de la fuente. No se
// invierte el slug al id original: se recalcula el MISMO slug para cada
// torneo del snapshot y se compara — simétrico, sin adivinar dónde termina
// el nombre y empieza el año.
const slug = Astro.params.slug ?? '';
const snapshot = await getChallengerCalendar();
const torneo = snapshot.tournaments.find((t) => challengerSlug(t.id) === slug);
const partidos = torneo ? snapshot.matches.filter((m) => m.tournamentId === torneo.id) : [];

if (!torneo) return Astro.redirect('/', 302);

/**
 * Pronóstico de cada partido.
 *
 * Se pide en paralelo y de forma tolerante: estos jugadores vienen de una
 * fuente externa con su propia forma de escribir los nombres, así que una
 * parte no se va a poder identificar en la base. Cuando eso pasa se dice, en
 * vez de inventar una probabilidad.
 *
 * El circuito va como 'Challenger', que ahora resuelve contra el Elo ATP:
 * promote-challenger.ts metió estos partidos en ese circuito precisamente
 * para que sus jugadores tuvieran un único rating.
 */
const pronosticos = await Promise.all(
  partidos.map(async (m) => {
    try {
      return await getModelForecast({
        tour: 'Challenger',
        playerOne: m.player1,
        playerTwo: m.player2,
        surface: null,
        marketType: 'match_winner',
        side: 'p1',
      });
    } catch {
      return null;
    }
  }),
);

const conPronostico = pronosticos.filter((p) => p?.available).length;

/**
 * Aces esperados, para los partidos cuyos dos jugadores sí se resolvieron.
 * Se piden con los ids que YA devolvió el pronóstico (p1Id/p2Id) — sin
 * resolver los nombres una segunda vez — y se descarta el partido si no
 * tiene muestra suficiente en algún lado, igual que en el resto del sitio.
 */
const aces = await getAceEstimatesForPairs(
  partidos
    .map((m, i) => ({ m, f: pronosticos[i] }))
    .filter(({ f }) => f?.available && f.p1Id !== undefined && f.p2Id !== undefined)
    .map(({ m, f }) => ({ key: m.id, p1: f!.p1Id!, p2: f!.p2Id! })),
);

const enJuego = partidos.filter((m) => m.status === 'live').length;
const pct = (x: number) => `${Math.round(x * 100)}%`;
const n1 = (x: number) => x.toFixed(1).replace('.', ',');
const hora = (iso: string) =>
  new Date(iso).toLocaleTimeString('es-CL', { hour: '2-digit', minute: '2-digit', timeZone: 'UTC' });

/**
 * Cuadro completo (todas las rondas ya jugadas), aparte de los partidos de
 * hoy de arriba. Es una petición más a la fuente — tolerante a fallo: si no
 * responde, la página sigue mostrando lo de hoy con normalidad, solo sin el
 * cuadro histórico.
 */
const draw = await getChallengerDraw(torneo.id).catch(() => null);
---

<Base title={`${torneo.name} · TENISMO`} active="home">
  <a href="/" class="mb-4 inline-flex items-center gap-1 text-sm text-court-ink no-underline hover:text-court">← Volver al panel</a>

  <header class="card mb-6 p-5 sm:p-6">
    <div class="flex flex-wrap items-center gap-2 text-2xs text-ink-muted">
      <span class="chip bg-surface-2 text-ink-muted">Challenger</span>
      {enJuego > 0 && (
        <span class="chip border border-live/30 bg-live/10 text-live">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-live"></span> {enJuego} en vivo
        </span>
      )}
    </div>
    <h1 class="mt-3 font-display text-3xl font-semibold tracking-tight text-ink">{torneo.name}</h1>
    <p class="mt-2 text-sm text-ink-muted">
      {partidos.length} partidos hoy · {conPronostico} con pronóstico del modelo
    </p>
  </header>

  {partidos.length === 0 ? (
    <div class="card p-4 text-sm text-ink-muted">Este torneo no tiene partidos publicados hoy.</div>
  ) : (
    <ul class="grid gap-3 md:grid-cols-2">
      {partidos.map((m, i) => {
        const f = pronosticos[i];
        // El pronóstico se pide siempre para p1, así que la probabilidad
        // devuelta es la suya y la del rival es el complemento.
        const p1 = f?.available && f.probability !== undefined ? f.probability : null;
        return (
          <li>
            <article class="card flex h-full flex-col p-4">
              <div class="flex items-center justify-between gap-2 text-2xs text-ink-faint">
                <span>{hora(m.startsAt)}</span>
                {m.status === 'live' ? (
                  <span class="chip border border-live/30 bg-live/10 text-live">
                    <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-live"></span> En juego
                  </span>
                ) : m.status === 'completed' ? (
                  <span class="chip bg-surface-2 text-ink-muted">Final</span>
                ) : (
                  <span class="chip bg-court/15 text-court-ink">Por jugar</span>
                )}
              </div>

              <div class="mt-3 space-y-2">
                <div class="flex items-center gap-2.5 text-sm text-ink">
                  <PlayerAvatar name={m.player1} size="sm" />
                  <span class="min-w-0 flex-1 truncate">{m.player1}</span>
                  {p1 !== null && <span class="shrink-0 font-mono text-2xs tabular-nums text-court">{pct(p1)}</span>}
                </div>
                <div class="flex items-center gap-2 pl-1" aria-hidden="true">
                  <span class="h-px flex-1 bg-line/60"></span>
                  <span class="text-[9px] font-semibold uppercase tracking-[0.18em] text-ink-faint">vs</span>
                  <span class="h-px flex-1 bg-line/60"></span>
                </div>
                <div class="flex items-center gap-2.5 text-sm text-ink">
                  <PlayerAvatar name={m.player2} size="sm" />
                  <span class="min-w-0 flex-1 truncate">{m.player2}</span>
                  {p1 !== null && <span class="shrink-0 font-mono text-2xs tabular-nums text-ink-muted">{pct(1 - p1)}</span>}
                </div>
              </div>

              <div class="mt-auto pt-3">
                {m.score && (
                  <p class="font-mono text-sm tabular-nums text-ink">{m.score}</p>
                )}
                {p1 !== null ? (
                  <div class="mt-2 flex items-center gap-2">
                    <div class="relative h-1.5 flex-1 overflow-hidden rounded-full bg-surface-2">
                      <div class="absolute inset-y-0 left-0 rounded-full bg-court" style={`width: ${p1 * 100}%`}></div>
                    </div>
                  </div>
                ) : (
                  <p class="mt-2 text-2xs leading-relaxed text-ink-faint">
                    {f?.unavailableReason ?? 'Sin pronóstico del modelo.'}
                  </p>
                )}

                {aces.has(m.id) && (() => {
                  const est = aces.get(m.id)!;
                  return (
                    <div class="mt-2 border-t border-line pt-2">
                      <div class="flex items-baseline justify-between text-2xs text-ink-faint">
                        <span class="uppercase tracking-wide">
                          Aces esperados
                          <span class="ml-1 normal-case tracking-normal" title="Challenger no publica superficie: se usa el perfil de saque de cada jugador contra la media del circuito.">
                            (sin superficie)
                          </span>
                        </span>
                        <span class="font-mono tabular-nums text-ink-muted">total {n1(est.total)}</span>
                      </div>
                      <div class="mt-1 flex gap-3 text-2xs text-ink-muted">
                        <span class="min-w-0 flex-1 truncate">
                          <span class="font-mono tabular-nums text-court">{n1(est.p1.expected)}</span>
                          {' '}{m.player1.split(' ')[0]}
                        </span>
                        <span class="min-w-0 flex-1 truncate text-right">
                          {m.player2.split(' ')[0]}{' '}
                          <span class="font-mono tabular-nums text-court">{n1(est.p2.expected)}</span>
                        </span>
                      </div>
                    </div>
                  );
                })()}
              </div>
            </article>
          </li>
        );
      })}
    </ul>
  )}

  {draw && draw.matches.length > 0 && (
    <section class="mt-8">
      <div class="mb-4"><p class="eyebrow">Histórico</p><h2 class="section-title mt-1">Cuadro</h2></div>
      <ChallengerDraw client:load rounds={draw.rounds} matches={draw.matches} />
    </section>
  )}

  <p class="mt-6 text-2xs leading-relaxed text-ink-faint">
    Los pronósticos usan el Elo por superficie de TENISMO, entrenado también con los partidos
    Challenger. Cuando un jugador no se reconoce en la base no se muestra probabilidad: no se
    rellena con una estimación inventada.
    {draw && draw.matches.length > 0 && ' El cuadro sale de la misma fuente que los partidos de hoy.'}
  </p>
</Base>
