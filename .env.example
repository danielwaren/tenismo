# ── Base de datos (PostgreSQL / Supabase; solo servidor) ─────────────────────
# Usa un rol dedicado con los permisos mínimos necesarios. Ninguna de estas
# variables puede llevar el prefijo PUBLIC_ ni llegar al navegador.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

# ── Cuotas de partidos futuros (Fase 2) ───────────────────────────────────────
# The Odds API, scope tenis. Sin esta key la ingesta de cuotas es un no-op
# explícito: NO se inventan cuotas a partir del modelo (regla no negociable).
ODDS_API_KEY=

# ── Calendario ATP Challenger (Sportradar Tennis API; solo servidor) ─────────
# Sin credencial, la interfaz lo indica y no muestra datos ficticios ni hace scraping.
SPORTRADAR_TENNIS_API_KEY=
SPORTRADAR_TENNIS_ACCESS_LEVEL=trial
SPORTRADAR_TENNIS_LANGUAGE=en
SPORTRADAR_TENNIS_HORIZON_DAYS=14
