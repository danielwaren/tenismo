# ── Base de datos (PostgreSQL / Supabase; solo servidor) ─────────────────────
# Usa un rol dedicado con los permisos mínimos necesarios. Ninguna de estas
# variables puede llevar el prefijo PUBLIC_ ni llegar al navegador.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

# ── Auth de Supabase (solo para verificar el token de sesión de la app móvil,
# nunca para leer datos — ver src/lib/mobile-auth.ts) ─────────────────────────
# Misma clave publishable que ya lleva empaquetada la app móvil
# (EXPO_PUBLIC_SUPABASE_ANON_KEY en tenismo-app/.env). Sin prefijo PUBLIC_ a
# propósito: no debe inyectarse en ninguna página pública de este sitio.
SUPABASE_AUTH_PUBLISHABLE_KEY=

# ── Cuotas de partidos futuros ───────────────────────────────────────────────
# Fuente ACTUAL: odds-api.io (plan gratis 100/hora, 500/día, cubre Challenger
# e ITF). Crear cuenta gratis en https://odds-api.io — sin tarjeta. Si esta
# key está, odds-ingest-io.ts es la fuente y odds-ingest.ts (The Odds API) se
# salta solo. Ver docs/15-monetizacion.md.
ODDS_API_IO_KEY=
# Opcional: lista de casas separada por coma. Vacío = las que dé el plan.
ODDS_API_IO_BOOKMAKERS=

# Fuente ANTERIOR (fallback): The Odds API. Plan gratis 500/MES — el US Open
# lo agotó en sept 2026. Se deja como respaldo; sin ODDS_API_IO_KEY y con esta
# sí, vuelve a usarse. Sin ninguna de las dos, la ingesta de cuotas es un
# no-op explícito: NO se inventan cuotas a partir del modelo (regla no negociable).
ODDS_API_KEY=
# Mercados a pedir. CADA UNO CUESTA 1 CRÉDITO por torneo y corrida.
# Por defecto 'h2h,totals' (2 créditos): el hándicap de juegos está pausado
# porque el motor punto a punto acierta 51,2% en dirección de margen — moneda
# al aire (400 partidos, sept 2026). El mercado NO se eliminó: para reactivarlo
# poner 'h2h,totals,spreads'. Ver DEFAULT_ODDS_MARKETS en scripts/lib/odds-api.ts.
ODDS_API_MARKETS=

# ── Calendario ATP Challenger (Sportradar Tennis API; solo servidor) ─────────
# Sin credencial, la interfaz lo indica y no muestra datos ficticios ni hace scraping.
SPORTRADAR_TENNIS_API_KEY=
SPORTRADAR_TENNIS_ACCESS_LEVEL=trial
SPORTRADAR_TENNIS_LANGUAGE=en
SPORTRADAR_TENNIS_HORIZON_DAYS=14

# ── Notificaciones push (PWA) ─────────────────────────────────────────────────
# Par de claves VAPID para Web Push — se generan UNA vez para todo el
# proyecto (no por entorno) con `npx web-push generate-vapid-keys`. La
# pública SÍ lleva PUBLIC_: la necesita el navegador para suscribirse
# (PushManager.subscribe). La privada firma los envíos y NUNCA sale del
# servidor — solo la usan los scripts que mandan notificaciones (nunca el
# sitio en sí, que solo guarda suscripciones).
PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: o https:// de contacto — lo exige el protocolo Web Push para que el
# servicio del navegador (FCM, Mozilla, etc.) pueda avisar si algo va mal.
VAPID_SUBJECT=mailto:you@example.com

# ── Publicidad (ver docs/15-monetizacion.md) ──────────────────────────────────
# Vacío = AdSlot.tsx no renderiza nada (sin cuenta todavía, sin decisión de red
# tomada — hay una nota de política de contenido de apuestas pendiente).
PUBLIC_ADSENSE_CLIENT_ID=
